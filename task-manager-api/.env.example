# Copie para .env e ajuste. Nunca versione o .env real.
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
LOG_LEVEL=INFO

# Obrigatória com APP_ENV=production. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///tasks.db

# Origens permitidas no CORS, separadas por vírgula. Vazio: nenhuma origem cruzada.
CORS_ORIGINS=

TOKEN_MAX_AGE_SECONDS=3600
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# Senhas dos usuários de demonstração criados por seed.py. Vazio: senha aleatória não exibida.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_MANAGER_PASSWORD=
