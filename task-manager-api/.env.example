# Exemplo de variáveis de ambiente (valores fictícios; não use em produção).
# Exporte-as no shell antes de rodar `python seed.py` / `python app.py`.

# Chave de assinatura de tokens. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=<gere-um-valor-aleatorio>
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
DATABASE_URL=sqlite:///tasks.db
# Origens autorizadas no CORS, separadas por vírgula (vazio = nenhuma origem externa).
CORS_ORIGINS=http://localhost:3000
TOKEN_MAX_AGE=28800
LOG_LEVEL=INFO

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<usuario-smtp>
SMTP_PASSWORD=<senha-smtp>

# Senhas dos usuários de demonstração criados por `python seed.py` (obrigatórias para o seed).
SEED_ADMIN_PASSWORD=<senha-admin>
SEED_MANAGER_PASSWORD=<senha-manager>
SEED_USER_PASSWORD=<senha-user>
