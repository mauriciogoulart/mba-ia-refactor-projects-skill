# Exemplo de variáveis de ambiente (valores fictícios; nunca versione um .env real).
PORT=3000
# test | development liberam o provedor de pagamento mock; qualquer outro valor (ou vazio) bloqueia.
APP_ENV=
DATABASE_FILE=:memory:
LOG_LEVEL=info
# Chave das rotas administrativas (Authorization: Bearer <chave>). Vazia = rotas administrativas negam tudo.
ADMIN_API_KEY=
# Senha do usuário de seed. Vazia = senha aleatória não divulgada.
SEED_USER_PASSWORD=
# Provedor de pagamento. Vazio = todo pagamento é recusado. "mock" só com APP_ENV=test|development.
PAYMENT_PROVIDER=
PAYMENT_MOCK_APPROVED_PREFIXES=
PAYMENT_GATEWAY_KEY=
CHECKOUT_RATE_LIMIT_MAX=30
CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
