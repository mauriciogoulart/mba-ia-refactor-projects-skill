# Copie para .env (não versionado) ou exporte no ambiente. Valores abaixo são fictícios.
PORT=3000
# Senha do usuário de demonstração (Leonan). Sem valor, o boot gera uma senha aleatória.
SEED_USER_PASSWORD=troque-esta-senha
# debug | info | warn | error
LOG_LEVEL=info
# Máximo de requisições de checkout por IP a cada minuto
CHECKOUT_RATE_MAX=30
