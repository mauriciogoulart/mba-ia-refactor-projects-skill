# Copie para .env (não versionado) ou exporte no ambiente. Valores abaixo são fictícios.
SECRET_KEY=<gere-uma-chave-aleatoria>
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
APP_ENV=producao
DB_PATH=loja.db
# Origens permitidas para CORS, separadas por vírgula (vazio = nenhuma origem externa)
CORS_ORIGINS=
# Senhas dos usuários de demonstração (só em dev/teste; sem elas os usuários não são criados)
SEED_ADMIN_PASSWORD=<senha-de-dev>
SEED_CLIENTE_PASSWORD=<senha-de-dev>
TOKEN_MAX_AGE=3600
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=300
